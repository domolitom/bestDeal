# bestDeal — Environment Variables
#
# Copy this file to .env.local (web) and/or .env (scraper) and fill in real
# values. Never commit the filled-in file — .env.local and .env are gitignored.
#
# Used by: scraper R2 storage adapter (packages/scraper/src/cli.ts,
# packages/scraper/src/cleanup.ts) and the web app's CDN/R2 helpers
# (packages/web/src/lib/storage.ts, packages/web/src/lib/image-url.ts,
# packages/web/next.config.ts).

# R2 (S3-compatible) endpoint for the Cloudflare R2 account, e.g.
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Name of the R2 bucket that stores scraped catalogs (defaults to
# "bestdeal-catalogs" in code if unset)
R2_BUCKET=bestdeal-catalogs

# R2 S3-compatible access key ID (scraper read/write access)
R2_ACCESS_KEY_ID=

# R2 S3-compatible secret access key (scraper read/write access)
R2_SECRET_ACCESS_KEY=

# Public base URL the R2 bucket is served from, e.g.
# https://cdn.best-deal-shops.com — also used by the web app as a fallback
# CDN URL if NEXT_PUBLIC_CDN_URL is not set
R2_PUBLIC_URL=

# Public CDN base URL the web app fetches manifest.json/images from
# (must be reachable from the Cloudflare Pages edge runtime)
NEXT_PUBLIC_CDN_URL=

# OpenAI API key, required only for `bun run scraper --auto-discover`
# (packages/scraper/src/auto-discover/config-generator.ts)
OPENAI_API_KEY=
