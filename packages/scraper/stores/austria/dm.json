{
    "name": "dm",
    "country": "austria",
    "landingUrl": "https://www.dm.at/dm-journal-447278",
    "waitAfterLoad": 10000,
    "linkDomain": "journal.dm.at",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "journal\\.dm\\.at/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "/page/1" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$3-$2-$1",
            "dateTo": "$6-$5-$4"
        }
    ]
}
