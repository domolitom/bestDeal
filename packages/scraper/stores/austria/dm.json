{
    "name": "dm",
    "country": "austria",
    "landingUrl": "https://journal.dm.at/",
    "waitAfterLoad": 3000,
    "linkDomain": "journal.dm.at",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "journal\\.dm\\.at/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "journal-([a-z]+)-(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
