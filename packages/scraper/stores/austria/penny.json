{
    "name": "penny",
    "landingUrl": "https://issuu.com/pennyat",
    "waitAfterLoad": 8000,
    "linkDomain": "issuu.com",
    "resolver": "issuu",
    "linkPatterns": [
        {
            "match": "issuu\\.com/pennyat/docs/(penny_[^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "_(\\d{1,2})\\.(\\d{2})\\._bis_[a-z]+_(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "_(\\d{1,2})\\.(\\d{2})\\._-_[a-z]+_(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
