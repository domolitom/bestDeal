{
    "name": "action",
    "landingUrl": "https://www.action.com/nl-be/folder/",
    "waitAfterLoad": 10000,
    "linkDomain": "folder.action.com",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "folder\\.action\\.com/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "https://folder\\.action\\.com/([^/?#]+).*", "replacement": "https://view.publitas.com/action/$1/page/1" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})/(\\d{2})\\s*-\\s*(\\d{1,2})/(\\d{2})/(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
