{
    "name": "carrefour",
    "landingUrl": "https://www.carrefour.be/nl/folders.html",
    "waitAfterLoad": 10000,
    "linkDomain": "publitas.com",
    "linkPatterns": [
        {
            "match": "view\\.publitas\\.com/[^/]+/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "resolver": "publitas",
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})/(\\d{2})/(\\d{4})\\s*-\\s*(\\d{1,2})/(\\d{2})/(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
