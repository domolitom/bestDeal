{
    "name": "lidl",
    "landingUrl": "https://www.lidl.be/c/nl-BE/folders-magazines/s10008101",
    "waitAfterLoad": 10000,
    "resolver": "publitas",
    "linkDomain": "folder-nl.lidl.be",
    "linkPatterns": [
        {
            "match": "folder-nl\\.lidl\\.be/([^/?#]+)$",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "append",
                    "suffix": "/page/1"
                }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})$",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        }
    ]
}
