{
    "name": "dm",
    "country": "bosnia",
    "landingUrl": "https://katalog.dm-drogeriemarkt.ba/",
    "waitAfterLoad": 3000,
    "linkDomain": "katalog.dm-drogeriemarkt.ba",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "katalog\\.dm-drogeriemarkt\\.ba/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "kw\\d+_(\\d+)-(\\d+)_(\\d+)-(\\d+)_(\\d{4})",
            "dateFrom": "$1-$2-$5",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})[^0-9]*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        }
    ]
}
