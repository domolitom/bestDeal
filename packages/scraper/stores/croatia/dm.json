{
    "name": "dm",
    "landingUrl": "https://katalog.dm.hr/",
    "waitAfterLoad": 3000,
    "linkDomain": "katalog.dm.hr",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "katalog\\.dm\\.hr/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})[^0-9]*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(siječanj|veljača|ožujak|travanj|svibanj|lipanj|srpanj|kolovoz|rujan|listopad|studeni|prosinac)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        }
    ]
}
