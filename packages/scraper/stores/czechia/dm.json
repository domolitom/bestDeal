{
    "name": "dm",
    "landingUrl": "https://journal.dm-drogeriemarkt.cz/",
    "waitAfterLoad": 3000,
    "linkDomain": "journal.dm-drogeriemarkt.cz",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "journal\\.dm-drogeriemarkt\\.cz/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "_(\\d{2})_(\\d{4})_",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})[^0-9]*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        }
    ]
}
