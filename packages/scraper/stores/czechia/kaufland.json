{
    "name": "kaufland",
    "landingUrl": "https://prodejny.kaufland.cz/letak.html",
    "waitAfterLoad": 3000,
    "linkDomain": "leaflets.kaufland.com",
    "linkPatterns": [
        {
            "match": "leaflets\\.kaufland\\.com/[^/]+/([^/]+)/ar/",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+/?$", "replacement": "" },
                {
                    "type": "else",
                    "condition": "/page/",
                    "ifTrue": { "type": "replace", "match": "/page/\\d+", "replacement": "/page/1" },
                    "ifFalse": { "type": "replace", "match": "/?$", "replacement": "/view/flyer/page/1" }
                }
            ]
        }
    ],
    "dateSource": "leaflets_api",
    "datePatterns": [],
    "catalogTypePattern": {
        "match": "CZ_cs_(\\w+?)[\\d_]",
        "caseInsensitive": true,
        "transform": "lowercase"
    }
}
