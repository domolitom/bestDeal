{
    "name": "norma",
    "country": "czechia",
    "landingUrl": "https://www.norma-online.de/cz/angebote/",
    "waitAfterLoad": 8000,
    "linkDomain": "norma-online.de",
    "resolver": "pdf",
    "linkPatterns": [
        {
            "match": "norma-online\\.de/cz/angebote/online-prospekt/(\\d{4}-\\d+_CZ)/",
            "slugGroup": 1,
            "normalizeUrl": []
        },
        {
            "match": "norma-online\\.de/[^/]+/([^/]+\\.pdf)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{4})-(\\d+)_CZ",
            "dateFrom": "KW$2-$1",
            "dateTo": "KW$2-$1"
        }
    ]
}
