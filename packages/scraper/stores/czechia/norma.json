{
    "name": "norma",
    "landingUrl": "https://www.norma-online.de/cz/angebote/",
    "waitAfterLoad": 5000,
    "linkDomain": "norma-online.de",
    "resolver": "pdf",
    "linkPatterns": [
        {
            "match": "norma-online\\.de/cz/angebote/online-prospekt/(\\d{4}-\\d+_CZ)/",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" },
                { "type": "replace", "match": "/$", "replacement": "" },
                { "type": "append", "suffix": ".pdf" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{4})-(\\d+)_CZ",
            "dateFrom": "KW$2-$1",
            "dateTo": "KW$2-$1"
        }
    ]
}
