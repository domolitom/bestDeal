{
    "name": "rossmann",
    "landingUrl": "https://www.rossmann.cz/obsah/akce-a-letaky",
    "waitAfterLoad": 8000,
    "resolver": "publitas",
    "iframeExtract": "publikace\\.rossmann\\.cz",
    "linkPatterns": [
        {
            "match": "/obsah/publitas/([^/]+/[^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{1,2})\\s*-\\s*(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
