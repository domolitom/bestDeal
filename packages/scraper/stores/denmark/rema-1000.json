{
    "name": "rema-1000",
    "landingUrl": "https://rema1000.dk/avis",
    "waitAfterLoad": 12000,
    "resolver": "tjek",
    "linkSelector": "img[src*='tjek.com']",
    "linkAttribute": "src",
    "linkPatterns": [
        {
            "match": "image-transformer-api\\.tjek\\.com/.*uploads(?:%2F|/)([^%/]+)(?:%2F|/)p-1",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": ".*",
                    "replacement": "https://rema1000.dk/avis"
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})[\\./-](\\d{1,2})(?:[\\./-](\\d{4}))?\\s*[-–]\\s*(\\d{1,2})[\\./-](\\d{1,2})[\\./-](\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
