{
    "name": "maxima",
    "landingUrl": "https://issuu.com/maxima_eesti",
    "waitAfterLoad": 8000,
    "linkDomain": "issuu.com",
    "resolver": "issuu",
    "linkPatterns": [
        {
            "match": "issuu\\.com/maxima_eesti/docs/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{4})(\\d{2})(\\d{2})_(\\d{4})(\\d{2})(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "kampaania-(\\d{2})(\\d{2})",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        },
        {
            "match": "(\\d{4})(\\d{2})(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        }
    ]
}
