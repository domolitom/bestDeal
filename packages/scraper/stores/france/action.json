{
    "name": "action",
    "landingUrl": "https://fr.publications.action.com/",
    "waitAfterLoad": 5000,
    "linkDomain": "fr.publications.action.com",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "fr\\.publications\\.action\\.com/([^/]+)/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+.*$", "replacement": "/page/1" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})/(\\d{2})/(\\d{2}).*?AU\\s+[^\\d]+(\\d{1,2})/(\\d{2})/(\\d{2})",
            "dateFrom": "$1-$2-20$3",
            "dateTo": "$4-$5-20$6"
        }
    ]
}
