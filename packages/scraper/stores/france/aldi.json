{
    "name": "aldi",
    "landingUrl": "https://www.aldi.fr/catalogue/cette-semaine.html",
    "waitAfterLoad": 8000,
    "linkDomain": "catalogues.aldi.fr",
    "linkPatterns": [
        {
            "match": "catalogues\\.aldi\\.fr/(kw\\d+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "kw(\\d{1,2})(\\d{4})",
            "dateFrom": "KW$1-$2",
            "dateTo": "KW$1-$2"
        }
    ]
}
