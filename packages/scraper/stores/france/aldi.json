{
    "name": "aldi",
    "landingUrl": "https://www.aldi.fr/catalogues/cette-semaine.html",
    "waitAfterLoad": 8000,
    "resolver": "ipaper",
    "linkDomain": "catalogues.aldi.fr",
    "linkPatterns": [
        {
            "match": "catalogues\\.aldi\\.fr/(kw\\d+)",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "kw(\\d{1,2})(\\d{4})",
            "dateFrom": "KW$1-$2",
            "dateTo": "KW$1-$2"
        }
    ]
}
