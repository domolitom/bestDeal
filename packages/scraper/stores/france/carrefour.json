{
    "name": "carrefour",
    "landingUrl": "https://www.carrefour.fr/catalogue/carrefour",
    "waitAfterLoad": 15000,
    "linkDomain": "carrefour.fr",
    "linkPatterns": [
        {
            "match": "carrefour\\.fr/catalogue/carrefour/(hypermarche-[^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "Du\\s+(\\d{1,2})\\s+(\\S+)\\s+au\\s+(\\d{1,2})\\s+(\\S+)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
