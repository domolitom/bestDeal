{
    "name": "conforama",
    "landingUrl": "https://www.conforama.fr/catalogue",
    "waitAfterLoad": 10000,
    "resolver": "pdf",
    "linkDomain": "conforama.fr",
    "linkPatterns": [
        {
            "match": "conforama\\.fr/m/webmaster/catalogues/([^/]+)/index\\.html",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/index\\.html$",
                    "replacement": "/common/data/catalogue.pdf"
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "Du\\s+(\\d{1,2})\\s+(\\S+)\\s+au\\s+(\\d{1,2})\\s+(\\S+)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
