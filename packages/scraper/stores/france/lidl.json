{
    "name": "lidl",
    "landingUrl": "https://www.lidl.fr/c/catalogues-en-ligne/s10017753",
    "waitAfterLoad": 8000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/catalogue-de-la-semaine/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/ar/\\d+.*$",
                    "replacement": "/view/flyer/page/1"
                }
            ]
        }
    ],
    "dateSource": "leaflets_api",
    "datePatterns": []
}
