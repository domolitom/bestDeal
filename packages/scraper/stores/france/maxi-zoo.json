{
    "name": "maxi-zoo",
    "country": "france",
    "landingUrl": "https://www.maxizoo.fr/promotions/offres-catalogue/",
    "waitAfterLoad": 8000,
    "linkDomain": "catalogue.maxizoo.fr",
    "linkPatterns": [
        {
            "match": "catalogue\\.maxizoo\\.fr/fressnapf/fr/([^/?]+/[^/?]+)(?:\\?.*)?$",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})/(\\d{2})/(\\d{4})\\s*[-–]\\s*(\\d{1,2})/(\\d{2})/(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
