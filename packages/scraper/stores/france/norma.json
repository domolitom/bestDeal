{
    "name": "norma",
    "landingUrl": "https://www.norma.fr/fr/bonnes-affaires/catalogues-interactifs/",
    "waitAfterLoad": 5000,
    "linkDomain": "norma.fr",
    "resolver": "pdf",
    "linkPatterns": [
        {
            "match": "norma\\.fr/fr/bonnes-affaires/catalogues_interactifs/(\\d{2}_\\d{2}_\\d{2})\\.pdf",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{2})_(\\d{2})_(\\d{2})",
            "dateFrom": "20$1-$2-$3",
            "dateTo": "20$1-$2-$3"
        }
    ]
}
