{
    "name": "fressnapf",
    "landingUrl": "https://www.fressnapf.de/prospekte",
    "waitAfterLoad": 10000,
    "linkDomain": "ipaper.io",
    "linkPatterns": [
        {
            "match": "viewer\\.ipaper\\.io/fressnapf[^/]*/([^/?#]+)/([^/?#]+)",
            "slugGroup": 0,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        },
        {
            "match": "ipapercms\\.dk/[Ff]ressnapf[^/]*/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "resolver": "ipaper",
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*(?:bis|-|–)\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*(?:bis|-|–)\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
