{
    "name": "hornbach",
    "landingUrl": "https://www.hornbach.de/aktuelles/prospekte-und-kataloge/",
    "waitAfterLoad": 10000,
    "linkDomain": "publications.hornbach.de",
    "linkPatterns": [
        {
            "match": "(?:hb\\.)?publications\\.hornbach\\.de/([^/?#]+)/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": []
        },
        {
            "match": "(?:hb\\.)?publications\\.hornbach\\.de/([^/?#]+)/?$",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/?$", "replacement": "/page/1" }
            ]
        }
    ],
    "resolver": "publitas",
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "prospekt-januar-(\\d{4})",
            "dateFrom": "01-01-$1",
            "dateTo": "31-01-$1"
        },
        {
            "match": "prospekt-februar-(\\d{4})",
            "dateFrom": "01-02-$1",
            "dateTo": "28-02-$1"
        },
        {
            "match": "prospekt-m.rz-(\\d{4})",
            "dateFrom": "01-03-$1",
            "dateTo": "31-03-$1"
        },
        {
            "match": "prospekt-april-(\\d{4})",
            "dateFrom": "01-04-$1",
            "dateTo": "30-04-$1"
        },
        {
            "match": "prospekt-mai-(\\d{4})",
            "dateFrom": "01-05-$1",
            "dateTo": "31-05-$1"
        },
        {
            "match": "prospekt-juni-(\\d{4})",
            "dateFrom": "01-06-$1",
            "dateTo": "30-06-$1"
        },
        {
            "match": "prospekt-juli-(\\d{4})",
            "dateFrom": "01-07-$1",
            "dateTo": "31-07-$1"
        },
        {
            "match": "prospekt-august-(\\d{4})",
            "dateFrom": "01-08-$1",
            "dateTo": "31-08-$1"
        },
        {
            "match": "prospekt-september-(\\d{4})",
            "dateFrom": "01-09-$1",
            "dateTo": "30-09-$1"
        },
        {
            "match": "prospekt-oktober-(\\d{4})",
            "dateFrom": "01-10-$1",
            "dateTo": "31-10-$1"
        },
        {
            "match": "prospekt-november-(\\d{4})",
            "dateFrom": "01-11-$1",
            "dateTo": "30-11-$1"
        },
        {
            "match": "prospekt-dezember-(\\d{4})",
            "dateFrom": "01-12-$1",
            "dateTo": "31-12-$1"
        },
        {
            "match": "[-_](\\d{4})(?:[-_]|$)",
            "dateFrom": "01-01-$1",
            "dateTo": "31-12-$1"
        }
    ]
}
