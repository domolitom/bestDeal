{
    "name": "lidl",
    "landingUrl": "https://www.lidl.de/c/online-prospekte/s10019227",
    "waitAfterLoad": 8000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/prospekte/([^/]+)/view/flyer/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/page/\\d+",
                    "replacement": "/page/1"
                }
            ]
        },
        {
            "match": "/l/prospekte/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/ar/\\d+",
                    "replacement": "/view/flyer/page/1"
                }
            ]
        }
    ],
    "leafletsOverviewConfig": {
        "clientLocale": "lidl/de-DE",
        "subcategoryFilter": "Unsere Aktionsprospekte"
    },
    "dateSource": "leaflets_api",
    "datePatterns": []
}
