{
    "name": "mueller",
    "landingUrl": "https://www.mueller.de/prospekte/",
    "waitAfterLoad": 8000,
    "linkDomain": "mueller-dam-bucket.s3.eu-central-1.amazonaws.com",
    "resolver": "pdf",
    "linkPatterns": [
        {
            "match": "mueller-dam-bucket\\.s3\\.eu-central-1\\.amazonaws\\.com/prod/shop-master/prospekte/([^/]+/[^/]+)/[^/]+\\.pdf",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s*(?:bis|-|–)\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.\\s*(?:bis|-|–)\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.?\\s*-\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
