{
    "name": "aldi",
    "landingUrl": "https://www.aldi.hu/hu/ajanlatok/online-akcios-ujsag.html",
    "waitAfterLoad": 8000,
    "linkDomain": "szorolap.aldi.hu",
    "linkPatterns": [
        {
            "match": "szorolap\\.aldi\\.hu/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "resolver": "publitas",
    "dateSource": "slug_then_text",
    "datePatterns": [
        {
            "match": "(\\d{4})_(\\d{2})_(\\d{2})_kw(\\d+)",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
