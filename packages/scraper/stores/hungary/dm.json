{
    "name": "dm",
    "country": "hungary",
    "landingUrl": "https://magazin.dm.hu/",
    "waitAfterLoad": 3000,
    "linkDomain": "magazin.dm.hu",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "magazin\\.dm\\.hu/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{4})-(\\d{2})",
            "dateFrom": "$2-$1",
            "dateTo": "$2-$1"
        },
        {
            "match": "(\\d{4})\\.(\\d{2})\\.(\\d{2})\\s*[-–]\\s*(\\d{4})\\.(\\d{2})\\.(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
