{
    "name": "fressnapf",
    "country": "hungary",
    "landingUrl": "https://www.fressnapf.hu/akciok",
    "waitAfterLoad": 8000,
    "linkDomain": "prospekt.fressnapf.hu",
    "linkPatterns": [
        {
            "match": "prospekt\\.fressnapf\\.hu/(?:fressnapf/hu/)?([^/?]+/[^/?]+)(?:\\?.*)?$",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{4})\\.(\\d{2})\\.(\\d{2})\\s*[-–]\\s*(\\d{4})\\.(\\d{2})\\.(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
