{
    "name": "lidl",
    "landingUrl": "https://www.lidl.ie/c/online-leaflets/s10020358",
    "waitAfterLoad": 8000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/en/leaflet/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+.*$", "replacement": "/view/flyer/page/1" }
            ]
        }
    ],
    "dateSource": "leaflets_api",
    "datePatterns": []
}
