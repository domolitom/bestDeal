{
    "name": "lidl",
    "landingUrl": "https://www.lidl.ie/c/online-leaflets/s10020358",
    "waitAfterLoad": 8000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/leaflets/([^/]+)/view/flyer/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "/page/1" }
            ]
        },
        {
            "match": "/leaflets/(leaflet[^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+", "replacement": "/view/flyer/page/1" }
            ]
        }
    ],
    "dateSource": "slug_then_text",
    "datePatterns": [
        {
            "match": "(\\d{2}-\\d{2})-(\\d{2}-\\d{2}-\\d{4})$",
            "dateFrom": "$1",
            "dateTo": "$2"
        },
        {
            "match": "(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec).*?[-–].*?(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\s*[-–]\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
