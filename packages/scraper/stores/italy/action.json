{
    "name": "action",
    "landingUrl": "https://it.publications.action.com/",
    "waitAfterLoad": 5000,
    "linkDomain": "it.publications.action.com",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "it\\.publications\\.action\\.com/([^/]+)/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+.*$", "replacement": "/page/1" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})-(\\d{2})-(\\d{2})\\s+A\\s+[^\\d]+(\\d{1,2})-(\\d{2})-(\\d{2})",
            "dateFrom": "$1-$2-20$3",
            "dateTo": "$4-$5-20$6"
        }
    ]
}
