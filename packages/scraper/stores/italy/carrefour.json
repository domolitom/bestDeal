{
    "name": "carrefour",
    "country": "italy",
    "landingUrl": "https://www.carrefour.it/volantino",
    "waitAfterLoad": 10000,
    "linkDomain": "view.publitas.com",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "view\\.publitas\\.com/p222-6048/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+.*$", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})/(\\d{2})/(\\d{4})\\s*[-–]\\s*(\\d{1,2})/(\\d{2})/(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "dal\\s+(\\d{1,2})\\s+(\\w+)\\s+al\\s+(\\d{1,2})\\s+(\\w+)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
