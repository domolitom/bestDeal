{
    "name": "maxima",
    "country": "latvia",
    "landingUrl": "https://issuu.com/maximalatvija",
    "waitAfterLoad": 8000,
    "linkDomain": "issuu.com",
    "resolver": "issuu",
    "linkPatterns": [
        {
            "match": "issuu\\.com/maximalatvija/docs/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\._-_(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$5",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{4})(\\d{2})(\\d{2})_(\\d{4})(\\d{2})(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{4})(\\d{2})(\\d{2})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        }
    ]
}
