{
    "name": "jumbo",
    "landingUrl": "https://view.publitas.com/jumbo-supermarkten/",
    "waitAfterLoad": 8000,
    "linkDomain": "publitas.com",
    "linkPatterns": [
        {
            "match": "view\\.publitas\\.com/jumbo-supermarkten/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "resolver": "publitas",
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2}) (\\w+) t/m (\\d{1,2}) (\\w+) (\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2}) (\\w+) t/m (\\d{1,2}) (\\w+)",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        },
        {
            "match": "(\\d{1,2})-(\\d{2})-(\\d{4})\\s*(?:t/m|-)\\s*(\\d{1,2})-(\\d{2})-(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
