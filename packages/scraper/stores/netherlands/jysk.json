{
    "name": "jysk",
    "landingUrl": "https://jysk.nl/campaign",
    "waitAfterLoad": 10000,
    "linkDomain": "ipapercms.dk",
    "linkPatterns": [
        {
            "match": "ipapercms\\.dk/[Jj][Yy][Ss][Kk]/nl/(?:CampaignPaper|localpapers)/([a-f0-9_-]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "W(\\d+)\\.(\\d{2})",
            "dateFrom": "KW$1-$2",
            "dateTo": "KW$1-$2"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
