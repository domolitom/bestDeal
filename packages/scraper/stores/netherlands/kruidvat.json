{
    "name": "kruidvat",
    "landingUrl": "https://folder.kruidvat.nl/",
    "waitAfterLoad": 8000,
    "linkDomain": "folder.kruidvat.nl",
    "linkPatterns": [
        {
            "match": "folder\\.kruidvat\\.nl/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "resolver": "publitas",
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{1,2})-([a-z]{3,})-(\\d{4})-t-m-(\\d{1,2})-([a-z]{3,})-(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
