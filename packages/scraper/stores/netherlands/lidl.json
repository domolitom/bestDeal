{
    "name": "lidl",
    "landingUrl": "https://www.lidl.nl/c/service-contact-folders/s10008124",
    "waitAfterLoad": 10000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/folders/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+.*$", "replacement": "/view/flyer/page/1" }
            ]
        }
    ],
    "dateSource": "slug_then_text",
    "datePatterns": [
        {
            "match": "wk(\\d+)-(\\d{4})",
            "dateFrom": "KW$1-$2",
            "dateTo": "KW$1-$2"
        },
        {
            "match": "(\\d{1,2})-(\\d{1,2})-(\\d{1,2})-(\\d{1,2})-(\\d{2,4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "Van (\\d{2})/(\\d{2}) tot (\\d{2})/(\\d{2})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        }
    ]
}
