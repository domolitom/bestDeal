{
    "name": "maxi-zoo",
    "landingUrl": "https://www.maxizoo.nl/folder",
    "waitAfterLoad": 5000,
    "linkDomain": "maxizoo.nl",
    "linkPatterns": [
        {
            "match": "maxizoo\\.nl/folder/(folder-week-\\d+)/?(?:\\?.*)?$",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                },
                {
                    "type": "replace",
                    "match": "/$",
                    "replacement": ""
                }
            ]
        }
    ],
    "iframeExtract": "heyzine\\.com",
    "resolver": "browser",
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})-(\\d{2})-(\\d{4})\\s*[-–/]\\s*(\\d{1,2})-(\\d{2})-(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
