{
    "name": "plus",
    "landingUrl": "https://view.publitas.com/plus-folder-nl/",
    "waitAfterLoad": 8000,
    "linkDomain": "folders.plus.nl",
    "linkPatterns": [
        {
            "match": "folders\\.plus\\.nl/(plus-week-[^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "resolver": "publitas",
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "plus-week-(\\d+)-(\\d{4})",
            "dateFrom": "KW$1-$2",
            "dateTo": "KW$1-$2"
        }
    ]
}
