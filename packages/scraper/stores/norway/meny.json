{
    "name": "meny",
    "landingUrl": "https://kundeavis.meny.no",
    "waitAfterLoad": 10000,
    "linkDomain": "kundeavis.meny.no",
    "linkPatterns": [
        {
            "match": "kundeavis\\.meny\\.no(/[^?#]*)?$",
            "slugGroup": 0,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
