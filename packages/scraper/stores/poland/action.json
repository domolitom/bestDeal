{
    "name": "action",
    "landingUrl": "https://pl.publications.action.com/",
    "waitAfterLoad": 5000,
    "linkDomain": "pl.publications.action.com",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "pl\\.publications\\.action\\.com/([^/]+)/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+.*$", "replacement": "/page/1" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.\\s+DO\\s+\\S+\\s+(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$5",
            "dateTo": "$3-$4-$5"
        }
    ]
}
