{
    "name": "lidl",
    "landingUrl": "https://www.lidl.pl/c/nasze-gazetki/s10008614",
    "waitAfterLoad": 10000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/pl/gazetki/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+.*$", "replacement": "/view/flyer/page/1" }
            ]
        }
    ],
    "dateSource": "slug_then_text",
    "datePatterns": [
        {
            "match": "od-(\\d{1,2})-(\\d{2})-do-(\\d{1,2})-(\\d{2})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        },
        {
            "match": "od-(\\d{1,2})-(\\d{2}).*kw(\\d+)",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        },
        {
            "match": "od-(\\d{2})-(\\d{2})",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
