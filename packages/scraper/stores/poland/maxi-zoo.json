{
    "name": "maxi-zoo",
    "country": "poland",
    "landingUrl": "https://www.maxizoo.pl/promocje-oferty/gazetka/",
    "waitAfterLoad": 5000,
    "linkDomain": "gazetka.maxizoo.pl",
    "linkPatterns": [
        {
            "match": "gazetka\\.maxizoo\\.pl/(?:gazetka-maxi-zoo|brochure/[^/?]+|[^/?]+/[^/?]+)(?:\\?.*)?$",
            "slugGroup": 0,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
