{
    "name": "rossmann",
    "landingUrl": "https://www.rossmann.pl/gazetki",
    "waitAfterLoad": 8000,
    "linkDomain": "pro-fra-s3-magazine.rossmann.pl",
    "resolver": "rossmann",
    "linkSelector": "img[src*='pro-fra-s3-magazine.rossmann.pl']",
    "linkAttribute": "src",
    "linkPatterns": [
        {
            "match": "pro-fra-s3-magazine\\.rossmann\\.pl/([a-f0-9-]{36})/[^/]+/bk_1\\.jpg",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/[^/]+/bk_1\\.jpg$",
                    "replacement": "/large/bk_1.jpg"
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\s*[-–]\\s*(\\d{1,2})\\s+(stycze[nń]|luty|marca|marzec|kwietnia|kwiecień|maja|maj|czerwca|czerwiec|lipca|lipiec|sierpnia|sierpień|wrze[sś]nia|wrzesień|pa[zź]dziernika|pa[zź]dziernik|listopada|listopad|grudnia|grudzie[nń])",
            "dateFrom": "$1-$3",
            "dateTo": "$2-$3"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
