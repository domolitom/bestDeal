{
    "name": "continente",
    "country": "portugal",
    "landingUrl": "https://www.continente.pt/folhetos/",
    "waitAfterLoad": 10000,
    "linkDomain": "folhetos.continente.pt",
    "resolver": "ipaper",
    "linkPatterns": [
        {
            "match": "folhetos\\.continente\\.pt/(\\d{4})/([^/?#]+)/([^/?#]+)/?",
            "slugGroup": 3,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "de\\s+(\\d{1,2})\\s+a\\s+(\\d{1,2})\\s+de\\s+(\\w+)",
            "dateFrom": "$1-$3",
            "dateTo": "$2-$3"
        },
        {
            "match": "(\\d{1,2})\\s+de\\s+(\\w+)\\s+a\\s+(\\d{1,2})\\s+de\\s+(\\w+)(?:\\s+de\\s+(\\d{4}))?",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        },
        {
            "match": "(\\d{1,2})/(\\d{2})/(\\d{4})\\s*(?:a|-)\\s*(\\d{1,2})/(\\d{2})/(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
