{
    "name": "animax",
    "landingUrl": "https://animax.ro/pages/catalog-animax",
    "waitAfterLoad": 10000,
    "linkDomain": "online.fliphtml5.com",
    "linkPatterns": [
        {
            "match": "fliphtml5\\.com/([^/]+)/([^/?#]+)",
            "slugGroup": 2,
            "normalizeUrl": []
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(ianuarie|februarie|martie|aprilie|mai|iunie|iulie|august|septembrie|octombrie|noiembrie|decembrie)(?:-[IVXivx]+)?-(\\d{4})",
            "flags": "i",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        }
    ]
}
