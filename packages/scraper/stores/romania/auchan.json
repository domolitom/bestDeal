{
    "name": "auchan",
    "landingUrl": "https://www.auchan.ro/cataloagele-auchan",
    "waitAfterLoad": 3000,
    "linkPatterns": [
        {
            "match": "/cataloagele-auchan/(catalog-[^/]+)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\s*-\\s*(\\d{1,2})\\s+(ianuarie|februarie|martie|aprilie|mai|iunie|iulie|august|septembrie|octombrie|noiembrie|decembrie)\\s+(\\d{4})",
            "dateFrom": "$1-$3",
            "dateTo": "$2-$3-$4"
        }
    ]
}
