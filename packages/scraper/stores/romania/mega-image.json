{
    "name": "mega-image",
    "landingUrl": "https://www.mega-image.ro/promotii-online/reviste-promo-online/revista-promo",
    "waitAfterLoad": 10000,
    "linkDomain": "view.publitas.com",
    "linkPatterns": [
        {
            "match": "view\\.publitas\\.com/mega-image/([^/]+)/page/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/page/\\d+",
                    "replacement": "/page/1"
                },
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{2})\\.(\\d{2})\\s*-\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
