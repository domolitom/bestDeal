{
    "name": "penny",
    "landingUrl": "https://www.penny.ro/vezi-pliantele-saptamanii",
    "waitAfterLoad": 8000,
    "linkDomain": "files.rewe.co.at",
    "resolver": "flippingbook",
    "linkPatterns": [
        {
            "match": "files\\.rewe\\.co\\.at/PennyIntLeaflet/RO/([^/]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{2})\\.(\\d{2})\\s*-\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\s*-\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$3",
            "dateTo": "$2-$3-$4"
        }
    ]
}
