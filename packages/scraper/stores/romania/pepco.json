{
    "name": "pepco",
    "landingUrl": "https://pepco.ro/brosuri/",
    "waitAfterLoad": 5000,
    "linkPatterns": [
        {
            "match": "/brosuri/((?!archiwum)[a-z][a-z0-9-]+[a-z0-9])/?$",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "Din (\\d{2})\\.(\\d{2})\\.(\\d{4}) până la (\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
