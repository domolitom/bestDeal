{
    "name": "selgros",
    "landingUrl": "https://www.selgros.ro/cataloage",
    "waitAfterLoad": 10000,
    "linkDomain": "www.yumpu.com",
    "linkPatterns": [
        {
            "match": "yumpu\\.com/\\w+/document/read/(\\d+)/([^/?#]+)",
            "slugGroup": 2,
            "normalizeUrl": []
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
