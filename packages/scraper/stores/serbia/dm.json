{
    "name": "dm",
    "landingUrl": "https://katalog.dm.rs/",
    "waitAfterLoad": 3000,
    "linkDomain": "katalog.dm.rs",
    "resolver": "publitas",
    "linkPatterns": [
        {
            "match": "katalog\\.dm\\.rs/([^/?#]+)",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/page/\\d+", "replacement": "" },
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\. (\\d{1,2})\\. do (\\d{1,2})\\. (\\d{1,2})\\. (\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{2})\\.(\\d{2})\\.(\\d{4})[^0-9]*(\\d{2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(januar|februar|mart|april|maj|jun|jul|avgust|septembar|oktobar|novembar|decembar)\\s+(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$1-$2"
        }
    ]
}
