{
    "name": "lidl",
    "landingUrl": "https://www.lidl.es/c/descubre-nuevas-ofertas-cada-semana-folletos-lidl/s10087402",
    "waitAfterLoad": 10000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/folletos/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                { "type": "replace", "match": "/ar/\\d+.*$", "replacement": "/view/flyer/page/1" }
            ]
        }
    ],
    "dateSource": "slug_then_text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})-(\\d{1,2})-(\\d{2})-(\\d{1,2})-(\\d{1,2})-(\\d{2})$",
            "dateFrom": "$1-$2-20$3",
            "dateTo": "$4-$5-20$6"
        },
        {
            "match": "Del (\\d{1,2})/(\\d{2}) al (\\d{1,2})/(\\d{2})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        }
    ]
}
