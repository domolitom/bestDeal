{
    "name": "bauhaus",
    "landingUrl": "https://www.bauhaus.se/veckokampanj",
    "waitAfterLoad": 10000,
    "linkDomain": "ipapercms.dk",
    "linkPatterns": [
        {
            "match": "ipapercms\\.dk/Bauhaus/Kampanjblad/(\\d{4})/([^/?#]+)",
            "slugGroup": 2,
            "normalizeUrl": [
                { "type": "replace", "match": "\\?.*$", "replacement": "" }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})/(\\d{1,2})\\s*-\\s*(\\d{1,2})/(\\d{1,2})\\s+(\\d{4})",
            "dateFrom": "$1-$2-$5",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})\\s*-\\s*(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\s*-\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
