{
    "name": "fressnapf",
    "landingUrl": "https://www.fressnapf.ch/de/app/leaflet/",
    "waitAfterLoad": 10000,
    "resolver": "ipaper",
    "linkDomain": "prospekt.fressnapf.ch",
    "linkPatterns": [
        {
            "match": "prospekt\\.fressnapf\\.ch/fressnapf/ch/([^/?]+/[^/?]+)/?(?:\\?.*)?$",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "\\?.*$",
                    "replacement": ""
                },
                {
                    "type": "replace",
                    "match": "/$",
                    "replacement": ""
                }
            ]
        }
    ],
    "dateSource": "text",
    "datePatterns": [
        {
            "match": "(\\d{1,2})\\.(\\d{1,2})\\.\\s*[-–]\\s*(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{1,2})\\.\\s*[-–]\\s*(\\d{1,2})\\.(\\d{1,2})\\.",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.(\\d{4})\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$4-$5-$6"
        },
        {
            "match": "(\\d{1,2})\\.(\\d{2})\\.?\\s*[-–]\\s*(\\d{1,2})\\.(\\d{2})\\.(\\d{4})",
            "dateFrom": "$1-$2",
            "dateTo": "$3-$4-$5"
        }
    ]
}
