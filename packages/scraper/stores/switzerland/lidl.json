{
    "name": "lidl",
    "landingUrl": "https://www.lidl.ch/c/de-CH/s10019683",
    "waitAfterLoad": 8000,
    "resolver": "leaflets",
    "linkPatterns": [
        {
            "match": "/l/de/prospekt/([^/]+)/ar/\\d+",
            "slugGroup": 1,
            "normalizeUrl": [
                {
                    "type": "replace",
                    "match": "/ar/\\d+.*$",
                    "replacement": "/view/flyer/page/1"
                }
            ]
        }
    ],
    "dateSource": "leaflets_api",
    "datePatterns": []
}
