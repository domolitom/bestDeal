{
    "name": "bm",
    "landingUrl": "https://www.bmstores.co.uk/leaflets",
    "waitAfterLoad": 5000,
    "resolver": "pdf",
    "linkDomain": "cdn.bmstores.co.uk",
    "linkPatterns": [
        {
            "match": "cdn\\.bmstores\\.co\\.uk/leaflets/(\\d{4}/[^?#]+\\.pdf)",
            "slugGroup": 1,
            "normalizeUrl": []
        }
    ],
    "dateSource": "slug",
    "datePatterns": [
        {
            "match": "(\\d{4})-(\\d{2})-(\\d{2})-[^/]+$",
            "dateFrom": "$1-$2-$3",
            "dateTo": "$1-$2-$3"
        }
    ]
}
